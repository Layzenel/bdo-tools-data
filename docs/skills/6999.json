=\"color: #e9bd23\">right spear</span> hits","<span style=\"color: #eb9261\">(Nullified during cooldown) </span>"],["<span style=\"color: #61d8ff\">Air Attack</span>"],["<span style=\"color: #61d8ff\">Down Attack</span> on attack 3 hits"],["<span style=\"color: #eb9261\">Damage reduced during cooldown</span>"],["<span style=\"color: #e9bd23\">39.27% </span><span style=\"color: #eb9261\">attacks 1 and 2 damage in PvP only </span>"],["<span style=\"color: #e9bd23\">57.93% </span><span style=\"color: #eb9261\">attack 3 damage in PvP only </span>"]]}}